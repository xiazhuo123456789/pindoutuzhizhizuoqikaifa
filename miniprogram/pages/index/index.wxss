.container {
  min-height: 100vh;
  background: #F5F1E8;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 标题区 */
.header {
  margin-bottom: 32rpx;
}

.brand {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.brand-mark {
  width: 56rpx;
  height: 56rpx;
  background: #C8F04A;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #20221F;
  margin-right: 16rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #20221F;
  margin-right: 12rpx;
}

.brand-sub {
  font-size: 20rpx;
  color: #8A8780;
  letter-spacing: 2rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
}

.hero-main {
  font-size: 44rpx;
  font-weight: 700;
  color: #20221F;
  line-height: 1.3;
}

.hero-em {
  font-size: 44rpx;
  font-weight: 700;
  color: #20221F;
  font-style: italic;
  text-decoration: underline;
  text-decoration-color: #C8F04A;
  text-decoration-thickness: 6rpx;
  text-underline-offset: 4rpx;
}

/* 上传区 */
.upload-section {
  background: #EDE8DA;
  border: 4rpx dashed #C8C4B8;
  border-radius: 24rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.upload-icon {
  font-size: 56rpx;
  color: #8A8780;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #20221F;
  margin-bottom: 8rpx;
}

.upload-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #8A8780;
}

/* 控制面板 */
.control-panel {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.panel-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #20221F;
}

.panel-num {
  width: 48rpx;
  height: 48rpx;
  background: #C8F04A;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  margin-right: 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #20221F;
}

.field-value {
  font-size: 26rpx;
  color: #6B8E23;
  font-weight: 600;
}

.slider {
  margin: 0;
}

.toggle-group {
  display: flex;
  gap: 16rpx;
}

.toggle-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #F5F1E8;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #8A8780;
  font-weight: 500;
  transition: all 0.2s;
}

.toggle-btn.active {
  background: #20221F;
  color: #C8F04A;
  font-weight: 600;
}

/* 预览区 */
.preview-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #20221F;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #C8F04A;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.canvas-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #FAF8F2;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 400rpx;
}

.bead-canvas {
  border-radius: 8rpx;
}

.canvas-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #B0ADA4;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

/* 材料清单 */
.material-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.material-eyebrow {
  display: block;
  font-size: 20rpx;
  color: #8A8780;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.material-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #20221F;
}

.material-total {
  text-align: right;
}

.total-num {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #20221F;
}

.total-label {
  font-size: 22rpx;
  color: #8A8780;
}

.material-list {
  max-height: 500rpx;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0EDE4;
}

.material-item:last-child {
  border-bottom: none;
}

.material-color {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  border: 2rpx solid rgba(0,0,0,0.08);
}

.material-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.material-code {
  font-size: 28rpx;
  font-weight: 700;
  color: #20221F;
}

.material-desc {
  font-size: 22rpx;
  color: #8A8780;
}

.material-qty {
  font-size: 32rpx;
  font-weight: 700;
  color: #20221F;
}

/* 底部导出按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(transparent, #F5F1E8 30%);
}

.export-btn {
  background: #20221F;
  color: #C8F04A;
  border-radius: 20rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(32,34,31,0.2);
}

.export-btn[disabled] {
  background: #C8C4B8;
  color: #8A8780;
  box-shadow: none;
}

.export-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

/* 隐藏的canvas */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 800px;
  height: 800px;
}
